{
  "name": "dsh-plugin-evalforge",
  "version": "0.1.0",
  "description": "EvalForge — builds verifiable medical benchmarks from ClinicalTrials.gov and runs multi-model evaluation inside DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "EvalForge contributors",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "medical-benchmark",
    "clinical-trials",
    "evaluation"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "locale/*.json",
    "icon.svg",
    "tests/**/*.js",
    "tests/fixtures/*.json",
    "scripts/*.mjs",
    "scripts/*.ps1",
    "README.md",
    "docs/**/*.md",
    "docs/screenshots/*.png",
    "examples/*",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "icon": "icon.svg",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:isolated": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "node scripts/check.mjs && node --test --test-isolation=none tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
